{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://podplay.local/schemas/booking-plan.schema.json",
  "title": "Preview Club Product-Neutral Booking Plan",
  "type": "object",
  "required": ["schemaVersion", "bookingPlanId", "occurrenceKey", "ownerActorId", "participantActorIds", "payerActorId", "venueRef", "window", "requestedFunding", "stage"],
  "properties": {
    "schemaVersion": {"const": 1},
    "bookingPlanId": {"type": "string", "pattern": "^booking-plan:"},
    "occurrenceKey": {"type": "string"},
    "ownerActorId": {"type": "string"},
    "participantActorIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "payerActorId": {"type": "string"},
    "venueRef": {"type": "string"},
    "window": {"type": "object", "required": ["startsAt", "endsAt"], "additionalProperties": false},
    "requestedFunding": {"type": "object", "required": ["chargeStrategy", "benefitStrategy"], "additionalProperties": false},
    "stage": {"enum": ["draft", "quoted", "awaiting_payer_approval", "approved", "blocked", "executed", "observed"]}
  },
  "additionalProperties": false
}
