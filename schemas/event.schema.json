{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://podplay.local/schemas/event.schema.json",
  "title": "Preview Club Event Projection",
  "type": "object",
  "required": ["schemaVersion", "occurrenceKey", "kind", "status", "result"],
  "properties": {
    "schemaVersion": {"const": 1},
    "occurrenceKey": {"type": "string"}, "kind": {"type": "string"}, "status": {"type": "string"},
    "socialIntentRef": {"type": ["string", "null"]}, "commitmentRefs": {"type": "array", "items": {"type": "string"}},
    "plannedWindow": {"type": ["object", "null"]}, "productEvidenceRef": {"type": ["string", "null"]},
    "productEventRef": {"type": ["string", "null"]},
    "result": {"type": "object"},
    "lastReducedFactId": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
