# Fake remains the default and only executable adapter in this milestone.
PODPLAY_SIM_MODE=fake

# Configure these together for `club doctor --mode preview-readonly`.
PODPLAY_SIM_PREVIEW_ORIGIN=
PODPLAY_SIM_ALLOWED_PREVIEW_ORIGINS=

# Preview writes are not implemented. When they are, this must repeat the exact
# approved preview origin rather than contain a boolean such as "true".
PODPLAY_SIM_CONFIRM_PREVIEW_WRITE=

# Identity only; credentials will remain in ignored local configuration.
PODPLAY_SIM_ADMIN_EMAIL=
